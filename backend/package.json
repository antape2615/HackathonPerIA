{
  "name": "periscan-ai-backend",
  "version": "1.0.0",
  "description": "Backend API para Periscan AI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "migrate": "tsx scripts/migrate.ts",
