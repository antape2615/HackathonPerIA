    "db:check": "npx prisma db push --accept-data-loss",
    "db:reset": "npx prisma migrate reset --force"
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@langchain/google-genai": "^0.0.8",
    "@prisma/client": "^5.7.1",
