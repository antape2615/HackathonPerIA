# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techbattle?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-me-in-production"
JWT_EXPIRATION="24h"
JWT_REFRESH_EXPIRATION="7d"

# Groq AI (GRATIS - obtener en https://console.groq.com/keys)
GROQ_API_KEY=

# App Configuration
PORT=4000
NODE_ENV=development

# CORS - Frontend URL
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Session/Test Configuration
TEST_SESSION_DURATION_MINUTES=60
AUTO_SAVE_INTERVAL_SECONDS=30
MAX_CODE_LENGTH=10000
